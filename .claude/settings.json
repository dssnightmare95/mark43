{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m action_capture.integrations.context_hook inject"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m action_capture.integrations.context_hook checkpoint"
          }
        ]
      }
    ]
  }
}
